Simulationpara <- function(EFXUsim, EFUYsim, volatilitysim, rateEFXUsim=0,
                           mu1, sigma1, mu2=0, sigma2=0, mu3=0, sigma3=0,
                           mu4=0, sigma4=0, Ito) {
  
