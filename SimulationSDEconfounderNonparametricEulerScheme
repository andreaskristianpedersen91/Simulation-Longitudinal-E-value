  } else if (Ito==2) {
    Confounder<-SimulatingconfounderIto2(mu1,sigma1,mu2,sigma2)
    mu_t<-mean(c(mu1,mu2))
    sigma_t<-mean(c(sigma1,sigma2))
    minmu_t<-min(c(mu1,mu2))
    minsigma_t<-min(c(sigma1,sigma2))
    maxmu_t<-max(c(mu1,mu2))
    maxsigma_t<-max(c(sigma1,sigma2))
  } else if (Ito==3) {
