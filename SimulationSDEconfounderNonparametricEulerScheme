    mu_t<-mean(c(mu1,mu2,mu3))
    sigma_t<-mean(c(sigma1,sigma2,sigma3))
    minmu_t<-min(c(mu1,mu2,mu3))
    minsigma_t<-min(c(sigma1,sigma2,sigma3))
    maxmu_t<-max(c(mu1,mu2,mu3))
