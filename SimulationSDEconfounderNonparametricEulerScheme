  SimulatingconfounderIto3<-function(mu1,sigma1,mu2,sigma2, mu3,sigma3){
    mod <- setModel(drift = mu1, diffusion = sigma1, state.variable = "Y", solve.variable = "Y", time.variable = "t", xinit = 1)
    samp <- setSampling(Terminal = 33, n = 33)
