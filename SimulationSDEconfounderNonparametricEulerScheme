    mod <- setModel(drift = mu2, diffusion = sigma2, state.variable = "Y", solve.variable = "Y", time.variable = "t", xinit = Simulation1[Simulation1$time==33,]$Confounder)
    samp <- setSampling(Terminal = 33, n = 33)
